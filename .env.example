# Bu dosyayı .env.mac veya .env.vps olarak kopyalayıp doldurun.
# .env* dosyaları .gitignore'dadır; ASLA depoya eklenmez.
#
# ÖZEL ANAHTAR BU DOSYAYA YAZILMAZ.
# Buradaki değişkenler yalnızca anahtarın NEREDE durduğunu söyler.
# Bir sır ortam değişkenine konursa süreç listesinde ve çökme raporlarında
# görünebilir; bu yüzden imza anahtarı macOS'ta Keychain'de, VPS'te izinleri
# 600 olan bir dosyada tutulur.

# live | demo | testnet   (Faz 5 varsayılanı: demo)
ALBSAT_ENVIRONMENT=demo

# API anahtarı kimliği. Bu gizli değildir; imzalama anahtarı değildir,
# yalnızca hangi anahtarın kullanılacağını söyler.
ALBSAT_API_KEY=

# --- İmza anahtarının konumu: ikisinden BİRİNİ doldurun ---

# macOS: Keychain'deki servis adı.
# Anahtarı şu komutla ekleyin (komut geçmişinde kalmaması için başına boşluk koyun):
#   security add-generic-password -s albsat-binance -a binance -w
ALBSAT_KEYCHAIN_SERVICE=albsat-binance

# VPS: Ed25519 özel anahtar dosyasının yolu. İzinleri 600 olmalı.
# ALBSAT_PRIVATE_KEY_PATH=/etc/albsat/ed25519.pem

# Arayüz yalnızca yerel makineye bağlanır (SPEC.md §5)
ALBSAT_BIND_HOST=127.0.0.1
ALBSAT_BIND_PORT=8787

# Telegram (Faz 4)
# ALBSAT_TELEGRAM_BOT_TOKEN=
# ALBSAT_TELEGRAM_CHAT_ID=

# Veri dizini
ALBSAT_DATA_DIR=./veri
