#!/bin/sh
# Depoya sır girmesin (SPEC §5): kaydedilecek dosyaları tarar, sır
# olabilecek bir şey bulursa kaydı durdurur. Etkinleştirmek için depoda bir
# kez:  git config core.hooksPath .githooks
# Yalnızca standart kütüphane kullanır; sanal ortam gerekmez.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec env PYTHONPATH=src python3 -m albsat.core.secretscan --staged
